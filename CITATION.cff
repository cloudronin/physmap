  - CC-BY-4.0
repository-code: "https://github.com/cloudronin/physmap"
url: "https://github.com/cloudronin/physmap"
keywords:
  - surrogate models
  - multiphysics
  - computational fluid dynamics
  - closure relations
  - model validity
  - uncertainty quantification
  - scientific machine learning
